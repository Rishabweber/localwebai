# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: rzp_live_TZyZ0SUWCVNqG8
# Test Mode Key starts with 'rzp_test_...'
# Get it from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_live_TZyZ0SUWCVNqG8"

# RAZORPAY_KEY_SECRET: NuSOPFWx3hHn1alRdZH6kpBq
# NEVER expose this on the client-side. Used for HMAC-SHA256 signature verification.
RAZORPAY_KEY_SECRET="NuSOPFWx3hHn1alRdZH6kpBq
"

# RAZORPAY_WEBHOOK_SECRET: https://ais-pre-qn5wft6owejx3ahdipffyw-628672339225.asia-east1.run.app/api/payment/razorpay/webhook
Webhook secret configured in Razorpay Webhook settings
# Defaults to RAZORPAY_KEY_SECRET if not explicitly set.
RAZORPAY_WEBHOOK_SECRET="https://ais-pre-qn5wft6owejx3ahdipffyw-628672339225.asia-east1.run.app/api/payment/razorpay/webhook"
